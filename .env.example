# Hospitality Management Operating System (HMS) Environment Configuration

# Django REST Framework API Base URL (Authoritative Backend)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Real-time WebSocket Gateway (Kitchen KOT, Housekeeping, Alerts)
VITE_WS_BASE_URL=ws://localhost:8000/ws

# Application Environment (development | staging | production)
VITE_APP_ENV=development

# Optional Public Map Client Key
VITE_MAPS_PUBLIC_KEY=

# Error Observability DSN (e.g. Sentry)
VITE_SENTRY_DSN=

# Hospitality Management Operating System (HMS) Environment Configuration

# Frontend Dev Server Port
VITE_PORT=5173

# Backend Target URL for Vite Proxy & API Requests
VITE_BACKEND_URL=https://3lrrk4tb-8000.inc1.devtunnels.ms
VITE_API_BASE_URL=/api/v1

# Real-time WebSocket Gateway
VITE_WS_TARGET=wss://3lrrk4tb-8000.inc1.devtunnels.ms
VITE_WS_GATEWAY_URL=wss://3lrrk4tb-8000.inc1.devtunnels.ms/ws/
VITE_WS_BASE_URL=wss://3lrrk4tb-8000.inc1.devtunnels.ms/ws

# Application Environment (development | staging | production)
VITE_APP_ENV=development

# Optional Public Map Client Key
VITE_MAPS_PUBLIC_KEY=

# Error Observability DSN (e.g. Sentry)
VITE_SENTRY_DSN=

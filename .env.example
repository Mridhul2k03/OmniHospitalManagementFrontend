# Hospitality Management Operating System (HMS) Environment Configuration

# Frontend Dev Server Port
VITE_PORT=5173

# Backend Target URL for Vite Proxy & API Requests
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Real-time WebSocket Gateway
VITE_WS_TARGET=ws://127.0.0.1:8000
VITE_WS_BASE_URL=ws://localhost:8000/ws

# Application Environment (development | staging | production)
VITE_APP_ENV=development

# Optional Public Map Client Key
VITE_MAPS_PUBLIC_KEY=

# Error Observability DSN (e.g. Sentry)
VITE_SENTRY_DSN=
